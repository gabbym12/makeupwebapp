{
  "name": "makeupwebapp",
  "version": "1.0.0",
  "description": "A makeup storefront",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc -b && tsc --noEmit -p tsconfig.server.json && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "preview": "vite preview --host 0.0.0.0 --port 5000 --strictPort"
  },
  "type": "module",
  "dependencies": {
    "@clerk/express": "^2.1.88",
    "@clerk/react": "^6.18.6",
    "@clerk/shared": "^4.44.1",
    "@clerk/themes": "^2.4.57",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-react": "^6.3.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "http-proxy-middleware": "^4.2.1",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
